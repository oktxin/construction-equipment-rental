generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EquipmentStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}

enum DeliveryType {
  PICKUP
  DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD_MOCK
  BANK_TRANSFER_MOCK
}

enum ReportType {
  ORDER_DOCUMENT
  RENTAL_HISTORY
  ADMIN_RENTAL_STATISTICS
  EQUIPMENT_UTILIZATION
}

enum ReportFormat {
  PDF
  DOCX
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id           String        @id @default(cuid())
  fullName     String
  email        String        @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  roleId       String
  isBlocked    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalOrders RentalOrder[]
  favorites    Favorite[]
  reviews      Review[]
  reports      Report[]

  @@index([roleId])
  @@index([isBlocked])
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?     @db.Text
  iconName    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  equipment   Equipment[]
}

model Equipment {
  id                String           @id @default(cuid())
  categoryId        String
  name              String
  slug              String           @unique
  shortDescription  String?          @db.VarChar(255)
  description       String?          @db.Text
  brand             String?
  model             String?
  dailyPrice        Decimal          @db.Decimal(10, 2)
  depositAmount     Decimal          @db.Decimal(10, 2)
  quantityTotal     Int
  quantityAvailable Int
  power             Decimal?         @db.Decimal(10, 2)
  weight            Decimal?         @db.Decimal(10, 2)
  status            EquipmentStatus  @default(AVAILABLE)
  isFeatured        Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  category          Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  images            EquipmentImage[]
  specs             EquipmentSpec[]
  rentalItems       RentalOrderItem[]
  favorites         Favorite[]
  reviews           Review[]

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([brand])
}

model EquipmentImage {
  id          String    @id @default(cuid())
  equipmentId String
  url         String
  alt         String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([equipmentId])
  @@index([equipmentId, sortOrder])
}

model EquipmentSpec {
  id          String    @id @default(cuid())
  equipmentId String
  name        String
  value       String
  unit        String?
  sortOrder   Int       @default(0)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([equipmentId])
  @@index([equipmentId, sortOrder])
}

model RentalOrder {
  id              String            @id @default(cuid())
  userId          String
  orderNumber     String            @unique
  status          OrderStatus       @default(PENDING)
  startDate       DateTime
  endDate         DateTime
  deliveryType    DeliveryType
  deliveryAddress String?           @db.Text
  customerComment String?           @db.Text
  managerComment  String?           @db.Text
  subtotal        Decimal           @db.Decimal(12, 2)
  depositTotal    Decimal           @db.Decimal(12, 2)
  deliveryPrice   Decimal           @db.Decimal(12, 2)
  totalPrice      Decimal           @db.Decimal(12, 2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items           RentalOrderItem[]
  payments        Payment[]
  reports         Report[]

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([createdAt])
}

model RentalOrderItem {
  id            String      @id @default(cuid())
  rentalOrderId String
  equipmentId   String
  quantity      Int
  dailyPrice    Decimal     @db.Decimal(10, 2)
  daysCount     Int
  lineTotal     Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
  rentalOrder   RentalOrder @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  equipment     Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([rentalOrderId])
  @@index([equipmentId])
}

model Favorite {
  id          String    @id @default(cuid())
  userId      String
  equipmentId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, equipmentId])
  @@index([userId])
  @@index([equipmentId])
}

model Review {
  id          String    @id @default(cuid())
  userId      String
  equipmentId String
  rating      Int
  text        String    @db.Text
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([equipmentId])
  @@index([isPublished])
}

model Payment {
  id            String        @id @default(cuid())
  rentalOrderId String
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  rentalOrder   RentalOrder   @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([rentalOrderId])
  @@index([status])
  @@index([method])
}

model Report {
  id            String       @id @default(cuid())
  userId        String
  rentalOrderId String?
  type          ReportType
  format        ReportFormat
  title         String
  fileUrl       String?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalOrder   RentalOrder? @relation(fields: [rentalOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([rentalOrderId])
  @@index([type])
  @@index([format])
}
